  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "NSIFStudentResponse": {
        "type": "object",
        "properties": {
          "student_id": {
            "type": "string"
          },
          "term": {
            "type": "string",
            "example": "F25"
          },
          "term_year": {
            "type": "integer",
            "nullable": true
          },
          "term_season": {
            "type": "string",
            "nullable": true,
            "enum": [
              "Fall",
              "Spring"
            ]
          },
          "full_name": {
            "type": "string",
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "net_id": {
            "type": "string",
            "nullable": true
          },
          "college": {
            "type": "string",
            "nullable": true
          },
          "department": {
            "type": "string",
            "nullable": true
          },
          "plan": {
            "type": "string",
            "nullable": true
          },
          "sub_plan": {
            "type": "string",
            "nullable": true
          },
          "campus": {
            "type": "string",
            "nullable": true
          },
          "career_interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Active career_* flag names"
          },
          "experience_preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Active exp_* flag names"
          },
          "involvement_interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Active inv_* flag names"
          },
          "career_othertext": {
            "type": "string",
            "nullable": true
          },
          "exp_othertext": {
            "type": "string",
            "nullable": true
          },
          "inv_othertext": {
            "type": "string",
            "nullable": true
          },
          "research_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Derived from career flags (CAREER_TO_DOMAINS)"
          }
        },
        "required": [
          "student_id",
          "term"
        ]
      },
      "NSIFStudentListResponse": {
        "type": "object",
        "properties": {
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NSIFStudentResponse"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        },
        "required": [
          "students",
          "total",
          "page",
          "page_size"
        ]
      },
      "NSIFFilterParams": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "nullable": true
          },
          "college": {
            "type": "string",
            "nullable": true,
            "description": "Case-insensitive substring match"
          },
          "career_interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "AND: student must have all"
          },
          "experience_preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "AND: student must have all"
          },
          "research_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "OR: student must have at least one"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "NSIFStatsResponse": {
        "type": "object",
        "properties": {
          "total_students": {
            "type": "integer"
          },
          "terms": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "colleges": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "career_interests": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "experience_preferences": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Omits F21-only exp_employment / exp_coop (as the real API does)"
          },
          "research_domains": {
            "type": "object",
            "additionalProperties": {
