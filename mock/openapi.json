{
  "openapi": "3.0.3",
  "info": {
    "title": "URR mock API",
    "version": "1.0.0",
    "description": "Read-only mock of the NSIF student-interest service plus CatCloud extension endpoints. Student data is synthetic; faculty are real (scraped from ur.arizona.edu on 2026-10-16); projects and match scores are synthetic/heuristic. Operations tagged `Extension` do not exist in the real NSIF service."
  },
  "servers": [
    {
      "url": "https://nzm36p0h50.execute-api.us-west-2.amazonaws.com/prod/api/v1"
    }
  ],
  "tags": [
    {
      "name": "NSIF",
      "description": "Ported from services/nsif/api/routes.py"
    },
    {
      "name": "Extension",
      "description": "Mock-only endpoints for the CatCloud prototype"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": [
          "NSIF"
        ],
        "responses": {
          "200": {
            "description": "OK",
