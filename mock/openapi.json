    "/matches": {
      "post": {
        "summary": "EXTENSION: rank projects for an NSIF student record",
        "tags": [
          "Extension"
        ],
        "description": "Pass the record returned by /students/by-netid/{net_id}. Mock heuristic; closed projects are excluded unless preferences.include_closed is true.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
